# Copy this file to .env and fill in your real values. Never commit .env.

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- monday.com (read-only) ---
MONDAY_API_TOKEN=your_monday_personal_api_token_here

# Board IDs from monday.com. Open a board and copy the number from the URL:
# https://<account>.monday.com/boards/<THIS_NUMBER>
MONDAY_DEALS_BOARD_ID=0000000000
MONDAY_WORK_ORDERS_BOARD_ID=0000000000

# Cache time-to-live in seconds for fetched board data (reduces API calls).
DATA_CACHE_TTL=300
